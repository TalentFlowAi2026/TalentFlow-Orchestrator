      {
        "name": "GOOGLE_OAUTH_REDIRECT_URI",
        "value": "[parameters('googleOauthRedirectUri')]"
      },
      {
        "name": "GOOGLE_CALENDAR_ENABLED",
        "value": "[string(parameters('googleCalendarEnabled'))]"
      },
      {
        "name": "GMAIL_ENABLED",
        "value": "[string(parameters('gmailEnabled'))]"
      },
      {
        "name": "SUPABASE_DB_URL",
        "secretRef": "supabase-db-url"
      },
      {
        "name": "DATA_ENCRYPTION_KEY",
        "secretRef": "data-encryption-key"
      }
    ],
    "googleEnvironment": "[if(or(parameters('googleCalendarEnabled'), parameters('gmailEnabled')), createArray(createObject('name', 'GOOGLE_OAUTH_CLIENT_SECRET', 'secretRef', 'google-oauth-client-secret')), createArray())]",
    "geminiEnvironment": "[if(parameters('geminiIntentEnabled'), createArray(createObject('name', 'GOOGLE_API_KEY', 'secretRef', 'google-api-key')), createArray())]",
    "commonEnvironment": "[concat(variables('baseEnvironment'), variables('googleEnvironment'), variables('geminiEnvironment'))]",
    "registryConfiguration": "[if(empty(parameters('registryServer')), createArray(), createArray(createObject('server', parameters('registryServer'), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', parameters('namePrefix'))]",
      "location": "[parameters('location')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-api', parameters('namePrefix'))]",
      "location": "[parameters('containerAppsLocation')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('containerAppsEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "registries": "[variables('registryConfiguration')]",
          "secrets": "[concat(createArray(createObject('name', 'supabase-db-url', 'keyVaultUrl', format('{0}secrets/orchestrator-supabase-db-url', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix')))), createObject('name', 'data-encryption-key', 'keyVaultUrl', format('{0}secrets/orchestrator-data-encryption-key', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))), if(or(parameters('googleCalendarEnabled'), parameters('gmailEnabled')), createArray(createObject('name', 'google-oauth-client-secret', 'keyVaultUrl', format('{0}secrets/orchestrator-google-oauth-client-secret', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))), createArray()), if(parameters('geminiIntentEnabled'), createArray(createObject('name', 'google-api-key', 'keyVaultUrl', format('{0}secrets/orchestrator-google-api-key', reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('namePrefix'))))), createArray()))]",
          "ingress": {
            "external": true,
            "allowInsecure": false,
            "targetPort": 8080,
            "transport": "http",
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "orchestrator-api",
              "image": "[parameters('containerImage')]",
              "command": [
                "talentflow-orchestrator-api"
              ],
              "env": "[variables('commonEnvironment')]",
              "resources": {
