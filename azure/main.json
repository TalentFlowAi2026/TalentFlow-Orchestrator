    "defaultInterviewDayEnd": {
      "type": "string",
      "defaultValue": "18:00",
      "minLength": 4,
      "maxLength": 8,
      "metadata": {
        "description": "Local-time end used for date-only scheduling when HR supplies no window."
      }
    },
    "apiMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 30
