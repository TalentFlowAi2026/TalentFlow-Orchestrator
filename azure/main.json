        "value": "[parameters('supabaseUrl')]"
      },
      {
        "name": "SUPABASE_AUTH_MODE",
        "value": "jwks"
      },
      {
        "name": "JWT_AUDIENCE",
        "value": "authenticated"
      },
      {
        "name": "PUBLIC_INTERVIEW_BASE_URL",
        "value": "[parameters('publicInterviewBaseUrl')]"
      },
      {
        "name": "BACKEND_MAX_PARALLEL_AI_INTERVIEWS",
        "value": "[string(parameters('backendMaxParallelAiInterviews'))]"
      },
      {
        "name": "DEFAULT_INTERVIEW_DAY_START",
        "value": "[parameters('defaultInterviewDayStart')]"
      },
      {
        "name": "DEFAULT_INTERVIEW_DAY_END",
        "value": "[parameters('defaultInterviewDayEnd')]"
      },
      {
        "name": "DATA_ENCRYPTION_KEY_VERSION",
        "value": "[parameters('dataEncryptionKeyVersion')]"
      },
      {
        "name": "GEMINI_SCHEDULING_MODEL",
        "value": "[parameters('geminiSchedulingModel')]"
      },
      {
        "name": "GEMINI_INTENT_TIMEOUT_SECONDS",
        "value": "[string(parameters('geminiIntentTimeoutSeconds'))]"
      },
      {
        "name": "GOOGLE_OAUTH_CLIENT_ID",
        "value": "[parameters('googleOauthClientId')]"
