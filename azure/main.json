    },
    "containerAppsLocation": {
      "type": "string",
      "defaultValue": "francecentral",
      "metadata": {
        "description": "Location of the existing Azure Container Apps environment."
      }
    },
    "keyVaultName": {
      "type": "string"
    },
    "supabaseUrl": {
      "type": "string"
    },
    "publicInterviewBaseUrl": {
      "type": "string"
    },
    "googleOauthClientId": {
      "type": "string",
      "defaultValue": ""
